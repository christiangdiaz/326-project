{
  "name": "326-project",
  "version": "1.0.0",
  "description": "Apartment maintenance report board: Express, EJS, htmx and MongoDB.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "npm run build:css && npm run build:vendor",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/style.css --minify",
    "build:vendor": "node scripts/copy-vendor.js",
    "lint": "eslint .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "seed": "node seed.js"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "collectCoverageFrom": [
      "controllers/**/*.js",
      "middleware/**/*.js",
      "services/**/*.js",
      "lib/**/*.js",
      "config/env.js",
      "sessions.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christiangdiaz/326-project.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/christiangdiaz/326-project/issues"
  },
  "homepage": "https://github.com/christiangdiaz/326-project#readme",
  "type": "module",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "htmx.org": "^2.0.4",
    "mongoose": "^9.9.1"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "tailwindcss": "^3.4.19"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
