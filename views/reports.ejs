<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Maintenance Report Board</title>

  <link rel="stylesheet" href="/style.css">

  <!-- Served from this origin rather than unpkg. A CDN <script> with no
       integrity attribute executes whatever that host returns, with full
       access to the session cookie and the page; vendoring the file is what
       lets the Content-Security-Policy say script-src 'self' and mean it. -->
  <script src="/vendor/htmx.min.js" defer></script>
  <script src="/app.js" defer></script>
</head>

<!-- Every htmx request carries the CSRF token as a header. Set once here
     rather than on each element so a new hx-* attribute cannot be added
     without it. -->
<body
  class="bg-gray-100 text-gray-900"
  hx-headers='{"X-CSRF-Token": "<%= csrfToken %>"}'
>
  <%- include("partials/header") %>

  <!-- tabindex="-1" so the skip link actually moves focus here rather than
       only scrolling; without it some browsers leave focus at the top. -->
  <main id="main" tabindex="-1" class="mx-auto max-w-5xl p-4 sm:p-8">
    <h1 class="mb-6 text-3xl font-bold">
      Maintenance Report Board
    </h1>

    <% if (error) { %>
      <p
        role="alert"
        class="mb-4 rounded bg-red-100 p-3 text-red-800"
      >
        <strong>Error:</strong>
        <%= error %>
      </p>
    <% } %>

    <% if (locals.user) { %>
      <section class="mb-10 rounded-lg bg-white p-5 shadow">
        <h2 class="mb-4 text-xl font-semibold">
          Submit a Report
        </h2>

        <form
          action="/reports"
          method="POST"
          class="space-y-4"
        >
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div>
            <label
              for="unit"
              class="mb-1 block font-medium"
            >
              Unit number
            </label>

            <input
              id="unit"
              name="unit"
              type="text"
              maxlength="10"
              placeholder="2C"
              class="w-full rounded border border-gray-500 p-2 placeholder:text-gray-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-800"
            >
          </div>

          <div>
            <label
              for="description"
              class="mb-1 block font-medium"
            >
              Problem description
            </label>

            <textarea
              id="description"
              name="description"
              rows="4"
              maxlength="500"
              class="w-full rounded border border-gray-500 p-2 placeholder:text-gray-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-800"
            ></textarea>
          </div>

          <button
            type="submit"
            class="rounded bg-blue-700 px-4 py-2 font-medium text-white hover:bg-blue-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-900"
          >
            Submit report
          </button>
        </form>
      </section>
    <% } else { %>
      <p class="mb-10 rounded-lg bg-white p-5 shadow">
        <a
          href="/login"
          class="font-medium text-blue-800 underline hover:text-blue-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-800"
        >
          Log in or sign up
        </a>
        to submit a maintenance report.
      </p>
    <% } %>

    <div class="mb-4 flex flex-wrap items-end justify-between gap-4">
      <h2
        id="reports-heading"
        tabindex="-1"
        class="text-2xl font-semibold"
      >
        Submitted Reports
      </h2>

      <!-- A plain GET form first: it filters correctly with JavaScript
           switched off, and the hx-* attributes only upgrade it to swap the
           list in place. The URL carries the filter either way, so a filtered
           board stays linkable. -->
      <form
        id="filters"
        method="GET"
        action="/reports"
        hx-get="/reports"
        hx-target="#report-list"
        hx-select="#report-list"
        hx-swap="outerHTML"
        hx-push-url="true"
        hx-trigger="submit, change, keyup changed delay:300ms from:#q"
        class="flex flex-wrap items-end gap-3"
      >
        <div>
          <label for="q" class="mb-1 block text-sm font-medium">
            Search reports
          </label>

          <input
            id="q"
            name="q"
            type="search"
            value="<%= filters.search %>"
            placeholder="unit or keyword"
            class="rounded border border-gray-500 p-2 text-sm placeholder:text-gray-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-800"
          >
        </div>

        <div>
          <label for="status" class="mb-1 block text-sm font-medium">
            Filter by status
          </label>

          <select
            id="status"
            name="status"
            class="rounded border border-gray-500 p-2 text-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-800"
          >
            <option value="">All statuses</option>

            <% statuses.forEach((status) => { %>
              <option
                value="<%= status %>"
                <%= filters.status === status ? "selected" : "" %>
              >
                <%= status %>
              </option>
            <% }) %>
          </select>
        </div>

        <button
          type="submit"
          class="rounded border border-gray-500 px-3 py-2 text-sm font-medium text-gray-900 hover:bg-gray-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-800"
        >
          Apply
        </button>
      </form>
    </div>

    <!-- Live updates arriving from another browser land here as an offer
         rather than an ambush: the list is never rewritten under a reader's
         cursor unless they ask for it. Hidden until app.js has something to
         report, and removed entirely when JavaScript is off. -->
    <p
      id="live-updates"
      hidden
      class="mb-4 flex flex-wrap items-center gap-3 rounded bg-blue-100 p-3 text-blue-900"
    >
      <span id="live-updates-text"></span>

      <button
        type="button"
        id="live-updates-refresh"
        class="rounded bg-blue-700 px-3 py-1 text-sm font-medium text-white hover:bg-blue-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-900"
      >
        Show new activity
      </button>
    </p>

    <!-- Announces the result of an htmx delete or status change, including the
         403 the service layer returns for someone else's report, which swaps
         nothing at all. -->
    <p
      id="delete-status"
      role="status"
      aria-live="polite"
      class="sr-only"
    ></p>

    <div id="report-list">
      <% if (reports.length === 0) { %>
        <p>
          <%= filters.status || filters.search
            ? "No reports match those filters."
            : "No reports submitted yet." %>
        </p>
      <% } %>

      <section class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <% reports.forEach((report) => { %>
          <%- include("partials/report-card", { report, statuses }) %>
        <% }) %>
      </section>
    </div>
  </main>
</body>
</html>
