<a
  href="#main"
  class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-10 focus:rounded focus:bg-white focus:px-4 focus:py-2 focus:font-medium focus:text-blue-800 focus:outline focus:outline-2 focus:outline-offset-2 focus:outline-blue-800"
>
  Skip to main content
</a>

<header class="border-b border-gray-300 bg-white">
  <nav
    aria-label="Main"
    class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 p-4"
  >
    <a
      href="/reports"
      class="rounded font-bold text-gray-900 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-800"
    >
      Maintenance Report Board
    </a>

    <% if (locals.user) { %>
      <div class="flex flex-wrap items-center gap-3">
        <span class="text-sm text-gray-700">
          Signed in as
          <strong class="text-gray-900"><%= user.email %></strong>

          <span class="ml-1 rounded bg-gray-200 px-2 py-1 text-gray-900">
            <%= user.role %>
          </span>
        </span>

        <form method="POST" action="/logout">
          <button
            type="submit"
            class="rounded border border-gray-500 px-3 py-2 text-sm font-medium text-gray-900 hover:bg-gray-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-800"
          >
            Log out
          </button>
        </form>
      </div>
    <% } else { %>
      <a
        href="/login"
        class="rounded px-3 py-2 text-sm font-medium text-blue-800 underline hover:text-blue-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-800"
      >
        Log in or sign up
      </a>
    <% } %>
  </nav>
</header>
