<%
  const badgeClass = {
    "Open": "bg-amber-100 text-amber-900",
    "In Progress": "bg-blue-100 text-blue-900",
    "Resolved": "bg-green-100 text-green-900"
  }[report.status] || "bg-gray-200 text-gray-900";
%>
<article
  id="report-<%= report._id %>"
  data-report-unit="<%= report.unit %>"
  data-report-status="<%= report.status %>"
  class="rounded-lg bg-white p-5 shadow"
>
  <div class="mb-3 flex items-start justify-between gap-4">
    <h3 class="text-lg font-bold">
      Unit <%= report.unit %>
    </h3>

    <span class="rounded px-2 py-1 text-sm font-medium <%= badgeClass %>">
      <%= report.status %>
    </span>
  </div>

  <p class="mb-5 text-gray-700">
    <%= report.description %>
  </p>

  <% if (locals.user) { %>
    <div class="flex flex-wrap items-end gap-3">
      <form
        hx-patch="/reports/<%= report._id %>/status"
        hx-target="#report-<%= report._id %>"
        hx-swap="outerHTML"
        class="flex flex-wrap items-end gap-2"
      >
        <div>
          <label
            for="status-<%= report._id %>"
            class="mb-1 block text-sm font-medium"
          >
            Status for unit <%= report.unit %>
          </label>

          <select
            id="status-<%= report._id %>"
            name="status"
            class="rounded border border-gray-500 p-2 text-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-800"
          >
            <% statuses.forEach((status) => { %>
              <option
                value="<%= status %>"
                <%= status === report.status ? "selected" : "" %>
              >
                <%= status %>
              </option>
            <% }) %>
          </select>
        </div>

        <button
          type="submit"
          class="rounded border border-gray-500 px-3 py-2 text-sm font-medium text-gray-900 hover:bg-gray-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-800"
        >
          Update
        </button>
      </form>

      <button
        hx-delete="/reports/<%= report._id %>"
        hx-target="#report-<%= report._id %>"
        hx-swap="outerHTML"
        hx-confirm="Delete this report?"
        aria-label="Delete report for unit <%= report.unit %>"
        class="rounded bg-red-700 px-3 py-2 text-sm font-medium text-white hover:bg-red-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-900"
      >
        Delete
      </button>
    </div>
  <% } %>
</article>
