# Copy to .env and fill in, or export these in your shell before `npm start`.
# Nothing here is read automatically — the app reads process.env, so use your
# shell, your process manager, or docker compose to load it.

# Signs the session cookie. REQUIRED in production, where the app refuses to
# start without it; generated per process in development, which means sessions
# do not survive a restart there.
#
# Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# development | production | test
NODE_ENV=development

PORT=3000

MONGODB_URI=mongodb://127.0.0.1:27017/maintenance_reports

# The one address that gets the admin role at signup. Admins can change and
# delete any report; everyone else can only touch their own. Leave blank and
# every account is a member.
ADMIN_EMAIL=

# Number of reverse proxies in front of the app, so req.ip is the real client
# rather than the proxy. Leave at 0 unless there genuinely is one: with it on,
# anyone can send an X-Forwarded-For header and pick their own rate-limit
# bucket.
TRUST_PROXY=0

# error | warn | info | debug
LOG_LEVEL=info
